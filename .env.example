# Paste your key here, or leave it and use the app's Setup page instead.
ANTHROPIC_API_KEY=sk-ant-...

# Model used to write lecture notes. Set from the Setup page; these are the
# supported values, cheapest first:
#   claude-haiku-4-5-20251001   ~$0.07-0.15 / lecture
#   claude-sonnet-5             ~$0.25-0.60 / lecture   (default)
#   claude-opus-5               ~$1.50-3.00 / lecture
LECNOTES_MODEL=claude-sonnet-5

LECNOTES_MAX_IMAGE_EDGE=1568
LECNOTES_PDF_DPI=150
